# Copy to .env (never commit), or set these variables in your host.
# The Android app never holds this key; it stays on the backend only.
GEMINI_API_KEY=your-google-ai-api-key
GEMINI_MODEL=gemini-3.6-flash
# Required by the Android client as Authorization: Bearer <token>.
# Use a long random value and keep it out of git.
GEMINI_BACKEND_TOKEN=replace-with-a-long-random-token
GEMINI_RATE_LIMIT_PER_MINUTE=10
