# Copy this file to local.properties for local Android development.
# Never commit local.properties or put a real API key in this example file.

# Android SDK path for your machine. Use forward slashes or escaped backslashes on Windows.
# sdk.dir=C:/Users/<your-user>/AppData/Local/Android/Sdk

# Development-only Gemini key. It will be embedded only in internal debug APKs.
# Do not use this key in a public/release APK.
GEMINI_API_KEY=
