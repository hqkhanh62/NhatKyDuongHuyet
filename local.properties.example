# Copy this file to local.properties for local development.
# Never commit local.properties or put real passwords in this example file.

# Android SDK path for your machine.
# sdk.dir=C:/Users/<your-user>/AppData/Local/Android/Sdk

# Production backend URL. This is configuration, not a Gemini provider secret.
GEMINI_BACKEND_URL=https://api.example.com/api/gemini/insight

# Optional local release signing values. Prefer CI secret variables for production.
# RELEASE_STORE_FILE=/absolute/path/to/release-upload-key.jks
# RELEASE_STORE_PASSWORD=
# RELEASE_KEY_ALIAS=
# RELEASE_KEY_PASSWORD=

# Optional version overrides.
# ANDROID_VERSION_CODE=1
# ANDROID_VERSION_NAME=1.0.0
